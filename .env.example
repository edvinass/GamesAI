POSTGRES_USER=gamesai
POSTGRES_PASSWORD=gamesai
POSTGRES_DB=gamesai
# Local dev (no Docker):
DATABASE_URL=postgresql+asyncpg://gamesai:gamesai@localhost:5432/gamesai
# Docker Compose uses host "postgres" instead of "localhost"

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=max

SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Railway deployment ---
# Local dev uses the variables above. On Railway, set service-specific variables instead.
#
# backend service:
#   DATABASE_URL          Linked from Railway Postgres plugin (auto-normalized to asyncpg)
#   SECRET_KEY            Strong random value
#   DEEPSEEK_API_KEY      Your DeepSeek API key
#   CORS_ORIGINS          Frontend public URL (e.g. https://gamesai.up.railway.app)
#
# frontend service:
#   BACKEND_URL           http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}
#   (no quotes; must match your backend service name — usually port 8080 on Railway)
#
# Generate a public domain for the frontend service — that is the URL players share.
