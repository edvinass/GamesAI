{
	admin off
}

:{$PORT} {
	root * /usr/share/caddy
	encode gzip

	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
	}

	handle /api/* {
		reverse_proxy {$BACKEND_URL}
	}

	handle /ws/* {
		reverse_proxy {$BACKEND_URL}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
