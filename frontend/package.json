{
  "name": "gamesai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy:tfjs-wasm": "node scripts/copy-tfjs-wasm.mjs",
    "fetch:katago-model": "node scripts/fetch-katago-9x9-model.mjs",
    "predev": "npm run copy:tfjs-wasm",
    "prebuild": "npm run copy:tfjs-wasm && npm run fetch:katago-model",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "earcut": "^3.2.3",
    "pako": "^2.1.0",
    "pinia": "^2.3.0",
    "planck": "^1.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/pako": "^2.0.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
